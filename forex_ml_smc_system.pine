//@version=6
indicator("Institutional SMC & ML Unified Advisor System [v6]", shorttitle="SMC_ML_Advisor", overlay=true, max_boxes_count=100, max_lines_count=200, max_labels_count=150)

// ══════════════════════════════════════════════════════════════════════════════
//  INPUTS & CONFIGURATION
// ══════════════════════════════════════════════════════════════════════════════
grpHTF      = "1. Higher Timeframe (HTF) Trend & Slope Gate"
htfPeriod   = input.timeframe("240", "HTF Timeframe (e.g. 240 for 4H)", group=grpHTF)
htfEmaLen   = input.int(20, "HTF Fast EMA Period", minval=5, group=grpHTF)
htfSlowLen  = input.int(50, "HTF Slow EMA Period", minval=10, group=grpHTF)
minH4Slope  = input.float(1.0, "Min 4H Slope for Promoted Trades (ATR Units)", minval=0.0, step=0.1, group=grpHTF)
primH4Slope = input.float(5.0, "Primary 4H Slope Threshold (Strong Trend)", minval=1.0, step=0.5, group=grpHTF)

grpSMC      = "2. Smart Money Concepts (SMC Zones & FVGs)"
swingLen    = input.int(5, "Swing High/Low Pivot Lookback", minval=2, maxval=20, group=grpSMC)
dispMult    = input.float(1.5, "Displacement Factor (x ATR)", minval=1.0, step=0.1, group=grpSMC)
maxZoneAge  = input.int(120, "Max Zone Age (Bars before Expiry)", minval=20, maxval=500, group=grpSMC)
showZones   = input.bool(true, "Show Order Blocks & FVGs", group=grpSMC)
colOBDemand = input.color(color.new(#089981, 80), "Bullish Order Block (Demand)", group=grpSMC)
colOBSupply = input.color(color.new(#f23645, 80), "Bearish Order Block (Supply)", group=grpSMC)

grpAdv      = "3. Unified Entry Advisor & Two-Stage Trigger"
useAdvGate  = input.bool(true, "Enforce Advisor Gate (Filter Toxic Trades / SKIPs)", group=grpAdv)
minWickAtr  = input.float(1.2, "Min Rejection Wick (x ATR)", minval=0.5, step=0.1, group=grpAdv)
primWickAtr = input.float(1.5, "Primary Rejection Wick (x ATR)", minval=1.0, step=0.1, group=grpAdv)
minConsec   = input.int(2, "Min Consecutive Directional Bars", minval=1, maxval=5, group=grpAdv)
m5ConsecMin = input.int(4, "Primary 5m Consecutive Exhaustion Bars", minval=2, maxval=10, group=grpAdv)
maxRR       = input.float(2.2, "Max Risk-Reward for Promoted Trades", minval=1.0, maxval=5.0, step=0.1, group=grpAdv)

grpRisk     = "4. Risk Management & Dynamic Stop Loss"
slPadBase   = input.float(0.4, "SL Base Buffer (x ATR beyond sweep extreme)", minval=0.1, step=0.1, group=grpRisk)
slPadWick   = input.float(0.6, "SL Wick-Scaled Buffer (x Rejection Wick)", minval=0.0, step=0.1, group=grpRisk)
defaultRR   = input.float(2.0, "Planned Take Profit Risk:Reward Ratio", minval=1.0, step=0.1, group=grpRisk)
useBe       = input.bool(true, "Show Break-Even (TP1 @ 1:1 R)", group=grpRisk)

grpHUD      = "5. Visual Display & Dashboard"
showDashboard = input.bool(true, "Show Status Dashboard (HUD)", group=grpHUD)
showSignals   = input.bool(true, "Plot Entry/SL/TP Levels", group=grpHUD)
alertType     = input.string("Formatted Text", "Alert Message Format", options=["Formatted Text", "JSON (Webhooks)"], group=grpHUD)

// ══════════════════════════════════════════════════════════════════════════════
//  LOCAL INDICATORS & ATR
// ══════════════════════════════════════════════════════════════════════════════
atrVal = ta.atr(14)
ema20  = ta.ema(close, 20)
ema50  = ta.ema(close, 50)
ema200 = ta.ema(close, 200)

// Consecutive directional approach bars
var int consecBull = 0
var int consecBear = 0
consecBull := close > open ? consecBull + 1 : 0
consecBear := close < open ? consecBear + 1 : 0

// ══════════════════════════════════════════════════════════════════════════════
//  MULTI-TIMEFRAME (HTF) ANALYSIS: 4H TREND & SLOPE
// ══════════════════════════════════════════════════════════════════════════════
// Request 4H EMA values safely without future lookahead
[htfEmaF, htfEmaS, htfClose] = request.security(syminfo.tickerid, htfPeriod, 
     [ta.ema(close, htfEmaLen), ta.ema(close, htfSlowLen), close], 
     barmerge.gaps_off, barmerge.lookahead_off)

// Calculate 4H EMA slope in units of 15m ATR
htfEmaPrev = nz(htfEmaF[1], htfEmaF)
rawH4Slope = (htfEmaF - htfEmaPrev) / (atrVal > 0 ? atrVal : syminfo.mintick * 10)
h4SlopeBull = rawH4Slope
h4SlopeBear = -rawH4Slope
htfTrendBull = htfEmaF > htfEmaS and htfClose > htfEmaF
htfTrendBear = htfEmaF < htfEmaS and htfClose < htfEmaF

// 5-Minute consecutive bars request for exhaustion check
m5Consec = request.security(syminfo.tickerid, "5", 
     close < open ? 1 : 0, 
     barmerge.gaps_off, barmerge.lookahead_off)

// ══════════════════════════════════════════════════════════════════════════════
//  ORDER BLOCKS & FAIR VALUE GAPS (SMC ENGINE)
// ══════════════════════════════════════════════════════════════════════════════
// Displacement: Impulsive expansion candle (> dispMult * ATR)
isDisplacementBull = (close - open) > (dispMult * atrVal) and close > high[1]
isDisplacementBear = (open - close) > (dispMult * atrVal) and close < low[1]

// FVG Imbalances
isFvgBull = low > high[2] and (low - high[2]) > (0.2 * atrVal)
isFvgBear = high < low[2] and (low[2] - high) > (0.2 * atrVal)

// Structure tracking types
type SMCZone
    box   zoneBox
    bool  isDemand
    float top
    float bottom
    float mid
    int   startBar
    bool  armed
    bool  triggered
    bool  violated
    float sweepExtreme

var SMCZone[] activeZones = array.new<SMCZone>()

// Zone Cleanup & Management
if barstate.isconfirmed and array.size(activeZones) > 0
    for i = array.size(activeZones) - 1 to 0
        SMCZone z = array.get(activeZones, i)
        // Age expiry
        if (bar_index - z.startBar) > maxZoneAge
            box.delete(z.zoneBox)
            array.remove(activeZones, i)
        // Violation check (candle close breaks distal edge)
        else if (z.isDemand and close < z.bottom) or (not z.isDemand and close > z.top)
            z.violated := true
            box.set_bgcolor(z.zoneBox, color.new(color.gray, 90))
            box.set_border_color(z.zoneBox, color.new(color.gray, 70))
            box.delete(z.zoneBox)
            array.remove(activeZones, i)

// Create New Zones on Confirmed Displacement
if barstate.isconfirmed
    if isDisplacementBull
        // Demand Order Block: Last bearish candle before impulsive breakout
        float obTop = math.max(open[1], close[1])
        float obBot = low[1]
        if obTop > obBot
            box b = box.new(bar_index - 1, obTop, bar_index + 10, obBot, 
                             bgcolor=colOBDemand, border_color=color.teal, border_width=1)
            SMCZone newZ = SMCZone.new(b, true, obTop, obBot, (obTop + obBot)/2.0, bar_index - 1, true, false, false, obBot)
            array.push(activeZones, newZ)

    if isDisplacementBear
        // Supply Order Block: Last bullish candle before impulsive drop
        float obTop = high[1]
        float obBot = math.min(open[1], close[1])
        if obTop > obBot
            box b = box.new(bar_index - 1, obTop, bar_index + 10, obBot, 
                             bgcolor=colOBSupply, border_color=color.maroon, border_width=1)
            SMCZone newZ = SMCZone.new(b, false, obTop, obBot, (obTop + obBot)/2.0, bar_index - 1, true, false, false, obTop)
            array.push(activeZones, newZ)

// Extend Active Boxes to Current Bar
if array.size(activeZones) > 0
    for i = 0 to array.size(activeZones) - 1
        SMCZone z = array.get(activeZones, i)
        if not z.violated and not z.triggered
            box.set_right(z.zoneBox, bar_index + 1)

// ══════════════════════════════════════════════════════════════════════════════
//  TWO-STAGE ZONE ARRIVAL & UNIFIED ADVISOR ENGINE
// ══════════════════════════════════════════════════════════════════════════════
// Candlestick anatomy for rejection confirmation
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
bodySize  = math.abs(close - open)

var float tradeEntry = na
var float tradeSL    = na
var float tradeTP    = na
var float tradeBE    = na
var string tradeTier = "NONE"
var string lastAdvice = "AWAITING ZONE"

bool buyConfirmed  = false
bool sellConfirmed = false
string currentSetupTier = "NONE"

if barstate.isconfirmed and array.size(activeZones) > 0
    for i = 0 to array.size(activeZones) - 1
        SMCZone z = array.get(activeZones, i)
        if z.armed and not z.triggered and not z.violated
            // ── DEMAND ZONE (BUY SETUP) ───────────────────────────────────────
            if z.isDemand
                // Stage 1: Price touches zone
                if low <= z.top and high >= z.bottom
                    // Update sweep extreme
                    z.sweepExtreme := math.min(z.sweepExtreme, low)
                    
                    // Stage 2: Confirmation on candle close
                    float wickNorm = lowerWick / (atrVal > 0 ? atrVal : syminfo.mintick)
                    bool isBullRejection = close > open and close > z.bottom and wickNorm >= minWickAtr
                    
                    if isBullRejection
                        // ── ADVISOR EVALUATION ────────────────────────────────
                        // Primary Setup (OR-71):
                        bool primSlope = h4SlopeBull >= primH4Slope
                        bool primWick  = wickNorm >= primWickAtr
                        bool isPrimary = primSlope or primWick
                        
                        // Skip Promotion Setup:
                        bool promoSlope = h4SlopeBull >= minH4Slope
                        bool promoConsec = consecBear[1] >= minConsec
                        bool isPromoted = promoSlope and promoConsec
                        
                        if isPrimary
                            currentSetupTier := "PRIMARY"
                        else if isPromoted
                            currentSetupTier := "PROMOTED"
                        else
                            currentSetupTier := "SKIP"
                        
                        // Execute if passes Advisor Gate
                        if not useAdvGate or (currentSetupTier == "PRIMARY" or currentSetupTier == "PROMOTED")
                            buyConfirmed := true
                            tradeTier := currentSetupTier
                            lastAdvice := "TAKE (" + currentSetupTier + ")"
                            z.triggered := true
                            
                            // Dynamic SL: Beyond sweep extreme + ATR pad + wick pad
                            float dynPad = (slPadBase * atrVal) + (slPadWick * lowerWick)
                            tradeEntry := close
                            tradeSL    := z.sweepExtreme - dynPad
                            float risk = tradeEntry - tradeSL
                            if risk < (5 * syminfo.mintick)
                                risk := 5 * syminfo.mintick
                                tradeSL := tradeEntry - risk
                            
                            tradeTP := tradeEntry + (risk * defaultRR)
                            tradeBE := tradeEntry + risk
                            break
                        else
                            lastAdvice := "FILTERED: SKIP (Conviction Low)"

            // ── SUPPLY ZONE (SELL SETUP) ──────────────────────────────────────
            else
                // Stage 1: Price touches zone
                if high >= z.bottom and low <= z.top
                    // Update sweep extreme
                    z.sweepExtreme := math.max(z.sweepExtreme, high)
                    
                    // Stage 2: Confirmation on candle close
                    float wickNorm = upperWick / (atrVal > 0 ? atrVal : syminfo.mintick)
                    bool isBearRejection = close < open and close < z.top and wickNorm >= minWickAtr
                    
                    if isBearRejection
                        // ── ADVISOR EVALUATION ────────────────────────────────
                        bool primSlope = h4SlopeBear >= primH4Slope
                        bool primWick  = wickNorm >= primWickAtr
                        bool isPrimary = primSlope or primWick
                        
                        bool promoSlope = h4SlopeBear >= minH4Slope
                        bool promoConsec = consecBull[1] >= minConsec
                        bool isPromoted = promoSlope and promoConsec
                        
                        if isPrimary
                            currentSetupTier := "PRIMARY"
                        else if isPromoted
                            currentSetupTier := "PROMOTED"
                        else
                            currentSetupTier := "SKIP"
                        
                        if not useAdvGate or (currentSetupTier == "PRIMARY" or currentSetupTier == "PROMOTED")
                            sellConfirmed := true
                            tradeTier := currentSetupTier
                            lastAdvice := "TAKE (" + currentSetupTier + ")"
                            z.triggered := true
                            
                            float dynPad = (slPadBase * atrVal) + (slPadWick * upperWick)
                            tradeEntry := close
                            tradeSL    := z.sweepExtreme + dynPad
                            float risk = tradeSL - tradeEntry
                            if risk < (5 * syminfo.mintick)
                                risk := 5 * syminfo.mintick
                                tradeSL := tradeEntry + risk
                            
                            tradeTP := tradeEntry - (risk * defaultRR)
                            tradeBE := tradeEntry - risk
                            break
                        else
                            lastAdvice := "FILTERED: SKIP (Conviction Low)"

// ══════════════════════════════════════════════════════════════════════════════
//  PLOTTING & SIGNALS
// ══════════════════════════════════════════════════════════════════════════════
// EMAs on Chart
plot(ema20,  "EMA 20",  color=color.new(#f59e0b, 20), linewidth=1)
plot(ema50,  "EMA 50",  color=color.new(#3b82f6, 30), linewidth=2)
plot(ema200, "EMA 200", color=color.new(#ffffff, 40), linewidth=2)

// Plot Signal Arrows
plotshape(buyConfirmed,  title="BUY Signal",  style=shape.triangleup,   
          location=location.belowbar, color=#00e676, size=size.normal, text="SMC BUY")
plotshape(sellConfirmed, title="SELL Signal", style=shape.triangledown, 
          location=location.abovebar, color=#ff5252, size=size.normal, text="SMC SELL")

// Trade Level Lines (Extended during active trade)
var line lnEntry = na
var line lnSL    = na
var line lnTP    = na
var line lnBE    = na

if barstate.isconfirmed and (buyConfirmed or sellConfirmed)
    line.delete(lnEntry)
    line.delete(lnSL)
    line.delete(lnTP)
    line.delete(lnBE)
    
    color colSig = buyConfirmed ? color.green : color.red
    lnEntry := line.new(bar_index, tradeEntry, bar_index + 15, tradeEntry, color=color.white, width=2, style=line.style_dashed)
    lnSL    := line.new(bar_index, tradeSL,    bar_index + 15, tradeSL,    color=color.red,   width=2)
    lnTP    := line.new(bar_index, tradeTP,    bar_index + 15, tradeTP,    color=color.green, width=2)
    if useBe
        lnBE := line.new(bar_index, tradeBE, bar_index + 15, tradeBE, color=color.yellow, width=1, style=line.style_dotted)

// ══════════════════════════════════════════════════════════════════════════════
//  HUD STATUS DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════
var table hud = table.new(position.top_right, 2, 8, bgcolor=color.new(#131722, 10), 
                          border_color=color.new(color.gray, 60), border_width=1)

if showDashboard and barstate.islast
    color htfColor = htfTrendBull ? color.green : (htfTrendBear ? color.red : color.gray)
    string htfTxt = htfTrendBull ? "BULLISH ▲" : (htfTrendBear ? "BEARISH ▼" : "NEUTRAL ▬")
    
    table.cell(hud, 0, 0, "SMC & ML Advisor", text_color=color.white, text_size=size.small, bgcolor=color.new(#2962ff, 30))
    table.cell(hud, 1, 0, "Status", text_color=color.white, text_size=size.small, bgcolor=color.new(#2962ff, 30))
    
    table.cell(hud, 0, 1, "4H Trend Bias", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, htfTxt, text_color=color.white, text_size=size.small, bgcolor=color.new(htfColor, 50))
    
    table.cell(hud, 0, 2, "4H EMA Slope", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(rawH4Slope, "#.##") + "x ATR", text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 3, "15m ATR (14)", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(atrVal, format.mintick), text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 4, "Active SMC Zones", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, str.tostring(array.size(activeZones)), text_color=color.white, text_size=size.small)
    
    table.cell(hud, 0, 5, "Advisor Gating", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5, useAdvGate ? "ENFORCED (On)" : "SHADOW (Off)", 
               text_color=color.white, text_size=size.small, 
               bgcolor=useAdvGate ? color.new(color.green, 60) : color.new(color.orange, 60))
               
    table.cell(hud, 0, 6, "Last Advisor Verdict", text_color=color.white, text_size=size.small)
    color advCol = tradeTier == "PRIMARY" ? color.green : (tradeTier == "PROMOTED" ? color.teal : color.orange)
    table.cell(hud, 1, 6, tradeTier, text_color=color.white, text_size=size.small, bgcolor=color.new(advCol, 40))
    
    table.cell(hud, 0, 7, "Last Setup Advice", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7, lastAdvice, text_color=color.white, text_size=size.small)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERTS & AUTOMATION (WEBHOOKS)
// ══════════════════════════════════════════════════════════════════════════════
if barstate.isconfirmed and (buyConfirmed or sellConfirmed)
    string act = buyConfirmed ? "BUY" : "SELL"
    string alertTxt = "SMC-ML " + act + " Signal on " + syminfo.ticker + 
                      " | Tier: " + tradeTier + 
                      " | Entry: " + str.tostring(tradeEntry, format.mintick) + 
                      " | SL: " + str.tostring(tradeSL, format.mintick) + 
                      " | TP: " + str.tostring(tradeTP, format.mintick) + 
                      " | R:R: 1:" + str.tostring(defaultRR)
                      
    string alertJson = "{\"action\":\"" + act + "\",\"symbol\":\"" + syminfo.ticker + 
                       "\",\"tier\":\"" + tradeTier + 
                       "\",\"entry\":" + str.tostring(tradeEntry, format.mintick) + 
                       ",\"sl\":" + str.tostring(tradeSL, format.mintick) + 
                       ",\"tp\":" + str.tostring(tradeTP, format.mintick) + 
                       ",\"rr\":" + str.tostring(defaultRR) + "}"
                       
    string finalMsg = (alertType == "JSON (Webhooks)") ? alertJson : alertTxt
    alert(finalMsg, alert.freq_once_per_bar_close)

alertcondition(buyConfirmed,  title="SMC ML Qualified BUY",  message="Qualified SMC BUY on {{ticker}} | SL={{plot_0}}")
alertcondition(sellConfirmed, title="SMC ML Qualified SELL", message="Qualified SMC SELL on {{ticker}} | SL={{plot_0}}")
